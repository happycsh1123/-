{
  "entities": {
    "User": {
      "title": "User",
      "description": "Student user account with nickname, growth metrics, and effort stats",
      "type": "object",
      "properties": {
        "nickname": {
          "type": "string",
          "description": "Student nickname",
          "minLength": 2,
          "maxLength": 20
        },
        "passwordHash": {
          "type": "string",
          "description": "SHA-256 hash of student password",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last login timestamp"
        },
        "bestSpeed": {
          "type": "number",
          "description": "Best average speed in seconds"
        },
        "initialSpeed": {
          "type": "number",
          "description": "Initial record speed in seconds"
        },
        "speedImprovement": {
          "type": "number",
          "description": "Improvement in seconds compared to initial speed"
        },
        "totalSolved": {
          "type": "number",
          "description": "Total solved problems for effort ranking"
        },
        "streakDays": {
          "type": "number",
          "description": "Consecutive attendance streak days"
        },
        "badges": {
          "type": "array",
          "description": "Array of earned master badge identifiers",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["nickname", "passwordHash", "createdAt"]
    },
    "GameScore": {
      "title": "GameScore",
      "description": "Hall of fame score record for multiplication training",
      "type": "object",
      "properties": {
        "nickname": {
          "type": "string",
          "description": "Student nickname",
          "minLength": 2,
          "maxLength": 20
        },
        "mode": {
          "type": "string",
          "description": "Training mode identifier",
          "enum": ["stage1", "table_easy", "table_hard", "speedrun", "reverse", "table_single"]
        },
        "modeTitle": {
          "type": "string",
          "description": "Friendly title of the mode",
          "maxLength": 50
        },
        "score": {
          "type": "number",
          "description": "Calculated score or points"
        },
        "correctCount": {
          "type": "number",
          "description": "Number of correct answers"
        },
        "wrongCount": {
          "type": "number",
          "description": "Number of wrong answers"
        },
        "accuracy": {
          "type": "number",
          "description": "Accuracy percentage"
        },
        "avgSpeed": {
          "type": "number",
          "description": "Average speed per question in seconds"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Record creation timestamp"
        }
      },
      "required": ["nickname", "mode", "score", "correctCount", "accuracy", "avgSpeed", "createdAt"]
    },
    "ClassStats": {
      "title": "ClassStats",
      "description": "Classroom collaborative goal and aggregate problem counts",
      "type": "object",
      "properties": {
        "totalProblemsSolved": {
          "type": "number",
          "description": "Cumulative problems solved by all students in class"
        },
        "targetGoal": {
          "type": "number",
          "description": "Current collaborative milestone problem goal"
        },
        "averageScore": {
          "type": "number",
          "description": "Class average score in 2-minute speedrun (out of 100)"
        },
        "targetScore": {
          "type": "number",
          "description": "Target average score starting at 80 and increasing by 5 weekly"
        },
        "currentWeek": {
          "type": "number",
          "description": "Current week number for progressive target calculation"
        },
        "totalScoreSum": {
          "type": "number",
          "description": "Sum of all 2-minute speedrun scores"
        },
        "totalParticipants": {
          "type": "number",
          "description": "Total speedrun attempts submitted"
        },
        "startDate": {
          "type": "string",
          "format": "date-time",
          "description": "Start date of the class challenge"
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time",
          "description": "Last milestone update timestamp"
        }
      },
      "required": ["totalProblemsSolved"]
    }
  },
  "firestore": {
    "/users/{nickname}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Learner accounts indexed by unique nickname"
    },
    "/game_scores/{scoreId}": {
      "schema": {
        "$ref": "#/entities/GameScore"
      },
      "description": "Hall of fame records for all learners"
    },
    "/class_stats/{statId}": {
      "schema": {
        "$ref": "#/entities/ClassStats"
      },
      "description": "Classroom collective progress and milestones"
    }
  }
}
